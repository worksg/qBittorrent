+	void session_impl::disconnect_temp_banned_ip(address const addr)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (m_abort) return;
+		auto const bucket = m_connections_by_ip.find(addr);
+		if (bucket == m_connections_by_ip.end()) return;
+		std::vector<std::shared_ptr<peer_connection>> peers;
+		peers.reserve(bucket->second.size());
+		for (auto const p : bucket->second)
+			peers.push_back(p->self());
+		for (auto const& p : peers)
+		{
+			if (p->type() != connection_type::bittorrent || p->is_disconnecting()) continue;
+			if (m_alerts.should_post<peer_blocked_alert>())
+			{
+				auto const t = p->associated_torrent().lock();
+				m_alerts.emplace_alert<peer_blocked_alert>(t ? t->get_handle() : torrent_handle()
+					, p->remote(), peer_blocked_alert::peer_filter);
+			}
+			p->disconnect(errors::banned_by_client_filter, operation_t::bittorrent);
+		}
+	}
