+TORRENT_TEST(peer_filter_cache_concurrent_const)
+{
+	peer_filter f;
+	error_code ec;
+	f.add_client("xunlei");
+	f.add_peer_id_regex("-XX[0-9]+-", ec);
+	TEST_CHECK(!ec);
+	f.add_client_regex("[Xx]unlei", ec);
+	TEST_CHECK(!ec);
+	std::atomic<bool> stop(false);
+	std::vector<std::thread> threads;
+	for (int i = 0; i < 8; ++i)
+	{
+		threads.emplace_back([&f, &stop]
+		{
+			int counter = 0;
+			while (!stop.load(std::memory_order_relaxed))
+			{
+				sha1_hash const pid = make_pid(counter % 2 ? "-XX0042-" : "-QQ0042-");
+				bool const blocked = f.peer_blocked(pid, "Xunlei 7.9", test_addr);
+				TEST_CHECK(blocked);
+				bool const allowed = f.peer_blocked(make_pid("-QQ0042-"), "qBittorrent", test_addr);
+				TEST_CHECK(!allowed);
+				++counter;
+			}
+		});
+	}
+	std::this_thread::sleep_for(std::chrono::milliseconds(200));
+	stop.store(true);
+	for (auto& t : threads) t.join();
+}
