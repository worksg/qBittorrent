+	// disconnects and removes all peers that are blocked by the peer filter
+	// (peer-id, client name or IP). Only peers with a live connection can be
+	// evaluated, since the peer-id is only known once the handshake has
+	// been received. Peers without a connection are re-evaluated when they
+	// connect. Blocked connections are disconnected and their peer entries
+	// removed from the peer list, regardless of whether the connection
+	// comes from an internal or external address.
+	void peer_list::apply_peer_filter(peer_filter const& filter
+		, torrent_state* state, std::vector<address>& banned)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		INVARIANT_CHECK;
+
+		for (iterator i = m_peers.begin(); i != m_peers.end();)
+		{
+			if ((*i)->connection == nullptr)
+			{
+				++i;
+				continue;
+			}
+			peer_connection_interface* p = (*i)->connection;
+			peer_id const& pid = p->pid();
+			address const remote_addr = p->remote().address();
+			// evaluate both the client name derived from the peer-id and
+			// the client version advertised in the BEP 10 extended
+			// handshake ("v" field), which may be more truthful for
+			// clients that spoof their peer-id
+			std::string const& client_version = p->client_version();
+			bool const blocked = filter.peer_blocked(pid
+					, aux::identify_client_impl(pid), remote_addr)
+				|| (!client_version.empty()
+					&& filter.peer_blocked(pid, client_version, remote_addr));
+			if (!blocked)
+			{
+				++i;
+				continue;
+			}
+			if (*i == m_locked_peer)
+			{
+				++i;
+				continue;
+			}
+
+			int const current = int(i - m_peers.begin());
+			TORRENT_ASSERT(current >= 0);
+			TORRENT_ASSERT(m_peers.size() > 0);
+			TORRENT_ASSERT(i != m_peers.end());
+
+			// disconnecting the peer here may also delete the
+			// peer_info_struct. If that is the case, just continue
+			int count = int(m_peers.size());
+
+			banned.push_back(remote_addr);
+
+			p->disconnect(errors::banned_by_client_filter
+				, operation_t::bittorrent);
+
+			// what *i refers to has changed, i.e. cur was deleted
+			if (int(m_peers.size()) < count)
+			{
+				i = m_peers.begin() + current;
+				continue;
+			}
+			TORRENT_ASSERT((*i)->connection == nullptr
+				|| (*i)->connection->peer_info_struct() == nullptr);
+
+			erase_peer(i, state);
+			i = m_peers.begin() + current;
+		}
+	}
