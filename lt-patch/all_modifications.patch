+struct temp_ban_peer : bt_peer_connection
+{
+	temp_ban_peer(temp_ban_session& fixture, tcp::endpoint const& remote)
+		: bt_peer_connection(make_args(fixture, remote))
+		, session(fixture.ses)
+	{}
+
+	void disconnect(error_code const& ec
+		, operation_t const op, disconnect_severity_t const severity = normal) override
+	{
+		++disconnects;
+		TEST_CHECK(ec == (session.is_aborted()
+			? errors::stopping_torrent : errors::banned_by_client_filter));
+		TEST_CHECK(op == operation_t::bittorrent);
+		TEST_CHECK(severity == normal);
+		m_disconnecting = true;
+		session.close_connection(this);
+	}
+
+	void mark_disconnecting() { m_disconnecting = true; }
+
+	void reset_remote() { m_remote = tcp::endpoint(); }
+
+	void associate(std::shared_ptr<torrent> const& t) { m_torrent = t; }
+
+	connection_type type() const override { return protocol; }
+
+	aux::session_impl& session;
+	connection_type protocol = connection_type::bittorrent;
+	int disconnects = 0;
+
+private:
+	static peer_connection_args make_args(temp_ban_session& fixture
+		, tcp::endpoint const& remote)
+	{
+		peer_connection_args args;
+		auto s = std::make_shared<aux::socket_type>(fixture.ios);
+		s->instantiate<tcp::socket>(fixture.ios);
+		args.s = s;
+		aux::temp_ban_test_access::insert_peer_args(fixture.ses, fixture.ios
+			, remote, args);
+		return args;
+	}
