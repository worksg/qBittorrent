+	std::string lower_ascii(std::string str)
+	{
+		for (char& c : str)
+			if (c >= 'A' && c <= 'Z') c = char(c + ('a' - 'A'));
+		return str;
+	}
+
+	// client version strings longer than this are matched without caching,
+	// to keep the cache bounded in memory
+	std::size_t const max_cached_client_size = 1024;
+
+	template <typename Match>
+	bool cached_match(std::mutex& mutex
+		, std::unordered_map<std::string, bool>& cache
+		, std::string const& key, Match const& match)
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			auto const it = cache.find(key);
+			if (it != cache.end()) return it->second;
+		}
+
+		bool const result = match();
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			if (cache.find(key) == cache.end())
+			{
+				if (cache.size() >= 4096) cache.erase(cache.begin());
+				cache.emplace(key, result);
+			}
+		}
+		return result;
+	}
+
+	bool is_ws(char const c)
+	{
+		return c == ' ' || c == '\t' || c == '\r';
+	}
+
+	// converts an IPv4-mapped IPv6 address (::ffff:a.b.c.d) to a plain
+	// IPv4 address, so IP rules written for IPv4 match such addresses too
+	address normalize_address(address const& a)
+	{
+		if (!a.is_v6()) return a;
+		address_v6::bytes_type const b = a.to_v6().to_bytes();
+		for (int i = 0; i < 10; ++i)
+			if (b[std::size_t(i)] != 0) return a;
+		if (b[10] != 0xff || b[11] != 0xff) return a;
+		address_v4::bytes_type v4 = {{ b[12], b[13], b[14], b[15] }};
+		return address(address_v4(v4));
+	}
+
+	int parse_prefix(std::string const& s, int const max, error_code& ec)
+	{
+		if (s.empty())
+		{
+			ec = errors::parse_failed;
+			return -1;
+		}
+		int ret = 0;
+		for (char const c : s)
+		{
+			if (c < '0' || c > '9')
+			{
+				ec = errors::parse_failed;
+				return -1;
+			}
+			ret = ret * 10 + (c - '0');
+			if (ret > max)
+			{
+				ec = errors::parse_failed;
+				return -1;
+			}
+		}
+		return ret;
+	}
+
+	bool parse_ip_rule(std::string const& arg, peer_filter& out, error_code& ec)
+	{
+		std::size_t const slash = arg.find('/');
+		if (slash != std::string::npos)
+		{
+			// subnet, e.g. "1.2.3.0/24" or "2001:db8::/32"
+			address const base = address::from_string(arg.substr(0, slash), ec);
+			if (ec) return false;
+
+			int const prefix = parse_prefix(arg.substr(slash + 1)
+				, base.is_v4() ? 32 : 128, ec);
+			if (ec) return false;
+
+			if (base.is_v4())
+			{
+				std::uint32_t const ip = base.to_v4().to_ulong();
+				std::uint32_t const mask = prefix == 0 ? 0U
+					: (0xffffffffU << (32 - prefix)) & 0xffffffffU;
+				std::uint32_t const first = ip & mask;
+				std::uint32_t const last = ip | ~mask;
+				out.add_rule(address_v4(first), address_v4(last)
+					, ip_filter::blocked);
+			}
+			else
+			{
+				address_v6::bytes_type const b = base.to_v6().to_bytes();
+				address_v6::bytes_type first;
+				address_v6::bytes_type last;
+				for (int i = 0; i < 16; ++i)
+				{
+					int const bits = std::max(0, std::min(8, prefix - i * 8));
+					std::uint8_t const mask = bits == 0
+						? 0 : std::uint8_t(0xff << (8 - bits));
+					first[std::size_t(i)] = std::uint8_t(b[std::size_t(i)] & mask);
+					last[std::size_t(i)] = std::uint8_t(b[std::size_t(i)] | ~mask);
+				}
+				out.add_rule(address_v6(first), address_v6(last)
+					, ip_filter::blocked);
+			}
+			return true;
+		}
+
+		std::size_t const dash = arg.find('-');
+		if (dash != std::string::npos)
+		{
+			// range, e.g. "1.2.3.4-1.2.3.10"
+			address const first = normalize_address(
+				address::from_string(arg.substr(0, dash), ec));
+			if (ec) return false;
+			address const last = normalize_address(
+				address::from_string(arg.substr(dash + 1), ec));
+			if (ec) return false;
+			if (first.is_v4() != last.is_v4())
+			{
+				ec = errors::parse_failed;
+				return false;
+			}
+			out.add_rule(first, last, ip_filter::blocked);
+			return true;
+		}
+
+		// single address
+		address const addr = normalize_address(address::from_string(arg, ec));
+		if (ec) return false;
+		out.add_rule(addr, addr, ip_filter::blocked);
+		return true;
+	}
+
+	bool parse_rule(char const* const begin, std::size_t const len
+		, peer_filter& out, error_code& ec)
+	{
+		std::size_t start = 0;
+		while (start < len && is_ws(begin[start])) ++start;
+		std::size_t end = len;
+		while (end > start && is_ws(begin[end - 1])) --end;
+		if (start == end) return true; // empty line
+		if (begin[start] == '#') return true; // comment
+
+		std::size_t kw_end = start;
+		while (kw_end < end && !is_ws(begin[kw_end])) ++kw_end;
+		std::string const keyword(begin + start, kw_end - start);
+
+		std::size_t arg_start = kw_end;
+		while (arg_start < end && is_ws(begin[arg_start])) ++arg_start;
+		std::string const arg(begin + arg_start, end - arg_start);
+
+		if (keyword == "ip")
+			return parse_ip_rule(arg, out, ec);
+		if (keyword == "peer")
+		{
+			out.add_peer_id(arg);
+			return true;
+		}
+		if (keyword == "client")
+		{
+			out.add_client(arg);
+			return true;
+		}
+		if (keyword == "peer-regex")
+		{
+			out.add_peer_id_regex(arg, ec);
+			return !ec;
+		}
+		if (keyword == "client-regex")
+		{
+			out.add_client_regex(arg, ec);
+			return !ec;
+		}
+
+		ec = errors::parse_failed;
+		return false;
+	}
+
+	// the maximum size of a rule file we accept to load into memory
+	std::size_t const max_rule_file_size = 64 * 1024 * 1024;
+
+} // anonymous namespace
+
+	bool is_internal_address(address const& a)
+	{
+		address const norm = normalize_address(a);
+		if (norm.is_v4())
+		{
+			std::uint32_t const ip = norm.to_v4().to_ulong();
+			return (ip & 0xff000000U) == 0x0a000000U // 10.0.0.0/8
+				|| (ip & 0xfff00000U) == 0xac100000U // 172.16.0.0/12
+				|| (ip & 0xffff0000U) == 0xc0a80000U // 192.168.0.0/16
+				|| (ip & 0xff000000U) == 0x7f000000U // 127.0.0.0/8
+				|| (ip & 0xffff0000U) == 0xa9fe0000U // 169.254.0.0/16
+				;
+		}
+		if (norm.is_v6())
+		{
+			if (norm.is_loopback()) return true;
+			address_v6::bytes_type const b = norm.to_v6().to_bytes();
+			if ((b[0] & 0xfe) == 0xfe) return true; // fe80::/10
+			if ((b[0] & 0xfe) == 0xfc) return true; // fc00::/7
+		}
+		return false;
+	}
+
+	void peer_filter::add_peer_id(std::string const& prefix)
+	{
+		if (prefix.empty()) return;
+		auto cache = std::make_shared<cache_state>();
+		if (prefix.size() > 20)
+			m_peer_ids.push_back(prefix.substr(0, 20));
+		else
+			m_peer_ids.push_back(prefix);
+		m_cache = std::move(cache);
+	}
+
+	void peer_filter::add_client(std::string const& client)
+	{
+		if (client.empty()) return;
+		auto cache = std::make_shared<cache_state>();
+		m_clients.push_back(lower_ascii(client));
+		m_cache = std::move(cache);
+	}
+
+	void peer_filter::add_peer_id_regex(std::string const& pattern, error_code& ec)
+	{
+		ec.clear();
+		if (pattern.empty()) return;
+		auto cache = std::make_shared<cache_state>();
+#ifndef BOOST_NO_EXCEPTIONS
+		try
+		{
+			m_peer_id_regexes.emplace_back(pattern);
+		}
+		catch (std::regex_error const&)
+		{
+			ec = errors::parse_failed;
+		}
+#else
+		m_peer_id_regexes.emplace_back(pattern);
+#endif
+		if (!ec) m_cache = std::move(cache);
+	}
+
+	void peer_filter::add_client_regex(std::string const& pattern, error_code& ec)
+	{
+		ec.clear();
+		if (pattern.empty()) return;
+		auto cache = std::make_shared<cache_state>();
+#ifndef BOOST_NO_EXCEPTIONS
+		try
+		{
+			m_client_regexes.emplace_back(pattern);
+		}
+		catch (std::regex_error const&)
+		{
+			ec = errors::parse_failed;
+		}
+#else
+		m_client_regexes.emplace_back(pattern);
+#endif
+		if (!ec) m_cache = std::move(cache);
+	}
+
+	void peer_filter::add_rule(address const& first, address const& last
+		, std::uint32_t const flags)
+	{
+		m_ip_filter.add_rule(first, last, flags);
+		if (flags & ip_filter::blocked) m_has_ip_rules = true;
+	}
+
+	void peer_filter::clear()
+	{
+		m_ip_filter = ip_filter();
+		m_peer_ids.clear();
+		m_clients.clear();
+		m_peer_id_regexes.clear();
+		m_client_regexes.clear();
+		m_has_ip_rules = false;
+		m_cache = std::make_shared<cache_state>();
+	}
+
+	bool peer_filter::empty() const
+	{
+		return !m_has_ip_rules && m_peer_ids.empty() && m_clients.empty()
+			&& m_peer_id_regexes.empty() && m_client_regexes.empty();
+	}
+
+	bool peer_filter::peer_blocked(peer_id const& pid, std::string const& client
+		, address const& addr) const
+	{
+		// normalize IPv4-mapped IPv6 addresses to plain IPv4 so that IP
+		// rules written for IPv4 match such addresses too
+		address const norm_addr = normalize_address(addr);
+
+		if (m_has_ip_rules && (m_ip_filter.access(norm_addr) & ip_filter::blocked))
+			return true;
+
+		if (!m_peer_ids.empty() || !m_peer_id_regexes.empty())
+		{
+			std::string const pid_str(pid.data(), static_cast<std::size_t>(pid.size()));
+			bool const blocked = cached_match(m_cache->mutex, m_cache->peer_ids
+				, pid_str, [this, &pid_str]
+			{
+				for (auto const& prefix : m_peer_ids)
+				{
+					if (pid_str.size() >= prefix.size()
+						&& std::equal(prefix.begin(), prefix.end(), pid_str.begin()))
+						return true;
+				}
+				for (auto const& re : m_peer_id_regexes)
+				{
+					if (std::regex_search(pid_str, re)) return true;
+				}
+				return false;
+			});
+			if (blocked) return true;
+		}
+
+		if (!client.empty() && (!m_clients.empty() || !m_client_regexes.empty()))
+		{
+			auto const client_match = [this](std::string const& c)
+			{
+				std::string const lower_client = lower_ascii(c);
+				for (auto const& rule : m_clients)
+				{
+					if (lower_client.find(rule) != std::string::npos) return true;
+				}
+				for (auto const& re : m_client_regexes)
+				{
+					if (std::regex_search(c, re)) return true;
+				}
+				return false;
+			};
+
+			if (client.size() > max_cached_client_size)
+			{
+				if (client_match(client)) return true;
+			}
+			else if (cached_match(m_cache->mutex, m_cache->clients, client
+				, [&client_match, &client] { return client_match(client); }))
+			{
+				return true;
+			}
+		}
+
+		return false;
+	}
+
+	bool load_peer_filter_file(std::string const& path, peer_filter& out
+		, error_code& ec)
+	{
+		ec.clear();
+		file f;
+		if (!f.open(path, open_mode::read_only, ec)) return false;
+
+		std::int64_t const size = f.get_size(ec);
+		if (ec || size < 0) return false;
+		if (size > std::int64_t(max_rule_file_size))
+		{
+			ec.assign(boost::system::errc::file_too_large
+				, boost::system::generic_category());
+			return false;
+		}
+
+		std::vector<char> buf(static_cast<std::size_t>(size));
+		if (size == 0) return true;
+
+		span<char> const view(buf);
+		std::int64_t const read = f.readv(0, view, ec);
+		if (ec) return false;
+		if (read != size)
+		{
+			ec.assign(boost::system::errc::io_error
+				, boost::system::generic_category());
+			return false;
+		}
+
+		std::size_t pos = 0;
+		std::size_t const len = buf.size();
+		while (pos < len)
+		{
+			std::size_t eol = pos;
+			while (eol < len && buf[eol] != '\n') ++eol;
+			if (eol > pos && !parse_rule(buf.data() + pos, eol - pos, out, ec))
+				return false;
+			pos = eol + 1;
+		}
+		return true;
+	}
+
+}
