+sha1_hash make_pid(std::string const& s)
+{
+	char buf[20] = {};
+	std::memcpy(buf, s.data(), s.size() > 20 ? 20 : s.size());
+	sha1_hash pid;
+	pid.assign(buf);
+	return pid;
+}
